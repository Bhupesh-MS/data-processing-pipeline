#!/bin/sh
# pre-commit hook to format and lint code

echo "Running pre-commit checks..."

# Check if there are any Go files staged
GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$')

if [ -z "$GO_FILES" ]; then
  exit 0
fi

# Run format and lint
echo "Formatting code..."
make format
if [ $? -ne 0 ]; then
  echo "❌ Formatter failed. Please fix formatting issues and try again."
  exit 1
fi

echo "Linting code..."
make lint
if [ $? -ne 0 ]; then
  echo "❌ Linter failed. Please fix linting issues and try again."
  exit 1
fi

# Since format might have changed files, we need to add them back
# (In practice, pre-commit should probably just check if format is correct,
# but auto-formatting is often what developers want)
git add $GO_FILES

echo "✅ Pre-commit checks passed!"
exit 0
